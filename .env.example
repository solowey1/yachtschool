# Telegram
BOT_TOKEN=
# Без @ — например, yachtschool_bot. Используется в текстах подсказок
# (inline-команды и т.п.). Узнать у @BotFather → /mybots.
BOT_USERNAME=

# Postgres (used by both services)
POSTGRES_USER=yachtschool
POSTGRES_PASSWORD=yachtschool
POSTGRES_DB=yachtschool

# Inline-режим без бутстрапа (опционально)
# Если задан HTTPS-URL, бот отдаёт через него PNG-флаги; настройте nginx
# на сервере: location /flags/ { proxy_pass http://127.0.0.1:8080; }.
# При пустом значении inline отдаёт текстовые «article» (или фото из
# кеша file_id, если выполнялась команда /preload_inline).
INLINE_PUBLIC_BASE_URL=
WEB_PORT=8080

# Daily delivery schedule (defaults for all users; каждый юзер
# может перебить в разделе «⚙️ Настройки»).
DAILY_DELIVERY_TIME=17:00
DAILY_DELIVERY_TIMEZONE=Europe/Moscow
DAILY_QUESTIONS_COUNT=5

# i18n
DEFAULT_LANGUAGE=ru

# Платная подробная статистика (Telegram Stars).
# ADMIN_TELEGRAM_ID — числовой Telegram id администратора: для него цена
# разблокировки = 1 ⭐ (для сквозной проверки оплаты без трат). Пусто = нет админа.
ADMIN_TELEGRAM_ID=
# Публичная цена разблокировки подробной статистики, в звёздах.
DETAILED_STATS_PRICE=1000

# Logging
LOG_LEVEL=INFO
